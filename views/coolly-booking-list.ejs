  <!-- about section -->

  <section class="about_section layout_padding">
    <div class="container  ">

      <div class="row">
        <!-- <div class="col-md-6 ">
          <div class="img-box">
            <img src="images/about-img.png" alt="">
          </div>
        </div> -->
        <div class="col-md-6">
          <div class="detail-box">
            <div class="heading_container">
              <h2>
                Coolly Chef
              </h2>
            </div>
           
             <p class="text-2xl font-semibold border-l-4 border-blue-600 pl-4 text-gray-800 mb-4" style="margin-left: -20px;">
              Today : 
              <span class="font-bold text-blue-700" style="color: rgb(233, 177, 24); font-size: larger;">
                <%= new Date().toLocaleDateString("th-TH", {
                  weekday: "long",
                  day: "2-digit",
                  month: "long",
                  year: "numeric"
                }) %>
              </span>
            </p>
          </div>
          
        </div>
      </div>

      <form id="filterForm" class="filter-bar">
        <div class="filter-item">
          <label>Filter</label>
          <select name="filter" onchange="this.form.submit()">
            <option value="all" <%= filter==="all"?"selected":"" %>>ทั้งหมด</option>
            <option value="thisMonth" <%= filter==="thisMonth"?"selected":"" %>>จองเดือนนี้</option>
            <option value="thisYear" <%= filter==="thisYear"?"selected":"" %>>จองปีนี้</option>
          </select>
        </div>

        <div class="filter-item">
          <label>Sort</label>
          <select name="sort" onchange="this.form.submit()">
            <option value="oldest" <%= sort==="oldest"?"selected":"" %>>เรียงวันที่น้อยไปมาก</option>
            <option value="newest" <%= sort==="newest"?"selected":"" %>>เรียงวันที่มากไปน้อย</option>
          </select>
        </div>

        <div class="filter-item">
          <label>Per Page</label>
          <select name="limit" onchange="this.form.submit()">
            <option value="10" <%= limit==10?"selected":"" %>>10</option>
            <option value="20" <%= limit==20?"selected":"" %>>20</option>
            <option value="50" <%= limit==50?"selected":"" %>>50</option>
          </select>
        </div>

        <input
          style="margin-top: 20px;"
          id="searchBox"
          name="search"
          type="text"
          value="<%= search || '' %>"
          placeholder="Search by name or phone…"
          class="px-3 py-2 rounded-lg border w-60 focus:ring focus:ring-blue-200"
        />

        <input type="hidden" name="page" value="<%= currentPage %>">

        <div class="filter-item">
          <label>Date</label>
          <input
            type="date"
            name="date"
            value="<%= selectedDate %>"
            onchange="this.form.submit()"
            class="px-2 py-1 rounded border"
          >
        </div>

      </form>

      

      

      

      <!-- <div class="table-responsive-custom"> -->
            <table class="responsive-table">
              <thead>
                <tr>
                  <th>#</th>
                  <th>ชื่อ</th>
                  <th>เบอร์โทร</th>
                  <th>เลขที่โต๊ะ</th>
                  <th>จำนวน</th>
                  <th>วันที่/เวลา</th>
                  <th>รายละเอียด</th>
                  <th>สถานะ</th>
                  <th>เช็คอิน</th>
                  <th>สลิป</th>
                  <th>ผู้จอง</th>
                  <th>แก้ไข</th>
                  <th>ลบ</th>
                </tr>
              </thead>

              <tbody>
                <% if (bookings.length === 0) { %>
                  <tr>
                    <td colspan="12" style="text-align:center; padding:20px;">
                      No reservations found
                    </td>
                  </tr>
                <% } %>
                <% bookings.forEach((b, index) => { %>
                  <tr class="booking-row">
                    <td data-label="#"><%= (currentPage - 1) * limit + index + 1 %></td>
                    <td data-label="Name"><%= b.name %></td>
                    <td data-label="Phone">0<%= b.phone %></td>
                    <td data-label="Table"><%= b.tables.join(", ") %></td>
                    <td data-label="Guest"><%= b.amount %></td>
                    <td data-label="Date/Time">
                      <% if (b.bookingDateTime) { %>
                        <%= new Date(b.bookingDateTime).toLocaleString("th-TH", {
                          timeZone: "Asia/Bangkok",
                          day: "2-digit",
                          month: "short",
                          year: "numeric",
                          hour: "2-digit",
                          minute: "2-digit",
                          hour12: false
                        }) %>
                      <% } else { %>
                        -
                      <% } %>
                    </td>
                    <td data-label="Note"><%= b.remark || "-" %></td>
                    <td data-label="Status"><%= b.status %></td>
                    <td>
                      <input type="checkbox"
                        class="checkin-toggle"
                        data-id="<%= b._id %>"
                        <%= b.status === "checkin" ? "checked" : "" %>
                      >
                    </td>
                    <td data-label="Slip">
                      <% if (b.image) { %>
                        <div class="image-hover-wrapper">
                          <img
                            src="<%= b.image %>"
                            class="slip-thumb"
                            alt="Slip Image"
                          >
                          <img
                            src="<%= b.image %>"
                            class="slip-preview"
                            alt="Slip Preview"
                          >
                        </div>
                      <% } else { %>
                        -
                      <% } %>
                    </td>
                    <td data-label="createBy"><%= b.createBy %></td>
                    <td>
                      <a href="/edit-booking-coolly/<%= b._id %>" class="btn-sm btn-edit">Edit</a>
                    </td>
                    <td>
                      <a href="/delete-coolly-booking/<%= b._id %>"
                        onclick="return confirm('Do you want to delete?')"
                        class="btn-sm btn-delete">Delete</a>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>

            

            <div>
              <% if (currentPage > 1) { %>
                <a href="?page=<%= currentPage - 1 %>&limit=<%= limit %>&sort=<%= sort %>&filter=<%= filter %>">Prev</a>
              <% } %>

              Page <%= currentPage %> of <%= totalPages %>

              <% if (currentPage < totalPages) { %>
                <a href="?page=<%= currentPage + 1 %>&limit=<%= limit %>&sort=<%= sort %>&filter=<%= filter %>">Next</a>
              <% } %>
            </div>

            <form style="margin-top: 15px;" class="filter-bar" action="/coolly-export-csv" method="GET" class="export-form">
  
              <div class="filter-item">
                <label>เลือกวันที่:</label>
                <input 
                  type="date" 
                  name="date" 
                  class="form-control"
                  required
                >

              </div>

              <div style="text-align: right; margin-top: 22px;">
                <button type="submit" class="btn btn-success">
                    Export CSV
                </button>
              </div>
              
            </form>

    </div>
  </section>

