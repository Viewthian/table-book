<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="shortcut icon" href="images/favicon.png" type="">
  <title>Login</title>

  <style>
    body {
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
      color: #e0e0e0;

      /* 🔥 Background Image */
      background: url("/images/bg-2.jpg") no-repeat center center fixed;
      background-size: cover;
    }

    /* Dark overlay to improve text contrast */
    .overlay {
      width: 100%;
      height: 100vh;
      background: rgba(0, 0, 0, 0.6);
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .login-box {
      width: 350px;
      background: rgba(30, 30, 30, 0.9);
      padding: 30px;
      border-radius: 12px;
      backdrop-filter: blur(6px);
      box-shadow: 0 0 20px rgba(0,0,0,0.6);
      animation: fadeIn 0.6s ease;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .login-box h2 {
      text-align: center;
      margin-bottom: 25px;
      color: #fff;
    }

    .input-group {
      margin-bottom: 20px;
    }

    .input-group label {
      display: block;
      margin-bottom: 6px;
      font-size: 14px;
      color: #bdbdbd;
    }

    .input-group input {
      width: 100%;
      padding: 10px;
      border: none;
      border-radius: 6px;
      background: #292929;
      color: #fff;
      font-size: 15px;
      outline: none;
    }

    .input-group input:focus {
      border: 1px solid #4a90e2;
    }

    button {
      width: 100%;
      padding: 12px;
      border: none;
      border-radius: 6px;
      font-size: 16px;
      background: #4a90e2;
      color: #fff;
      cursor: pointer;
      margin-top: 10px;
    }

    button:hover {
      background: #357abd;
    }

    .error {
      color: #ff6b6b;
      text-align: center;
      margin-top: 10px;
    }
  </style>
</head>
<body>

  <div class="overlay">
    <div class="login-box">
      <h2>The View Staffs Login</h2>

      <form action="/login" method="POST">

        <div class="input-group">
          <label>Username</label>
          <input type="text" name="username" required>
        </div>

        <div class="input-group">
          <label>Password</label>
          <input type="password" name="password" required>
        </div>

        <button type="submit">Login</button>

        <% if (typeof error !== "undefined") { %>
          <p class="error"><%= error %></p>
        <% } %>

      </form>
    </div>
  </div>

</body>
</html>
