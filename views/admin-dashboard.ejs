<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Admin Dashboard</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <style>
    body {
      background: #f8f9fa;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }
    .navbar {
      margin-bottom: 20px;
    }
    .card {
      border-radius: 15px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }
    .table th {
      background: #0d6efd;
      color: white;
    }
    .paid {
      color: #198754;
      font-weight: bold;
    }
    .unpaid {
      color: #dc3545;
      font-weight: bold;
    }
  </style>
</head>
<body>

  <!-- Navbar -->
  <nav class="navbar navbar-dark bg-primary">
    <div class="container-fluid">
      <span class="navbar-brand mb-0 h1">Admin Dashboard</span>
    </div>
  </nav>

  <div class="container">
    <!-- Revenue Section -->
    <div class="card mb-4">
      <div class="card-header bg-primary text-white">
        Revenue Dashboard
      </div>
      <div class="card-body">
        <canvas id="revenueChart" height="100"></canvas>
      </div>
    </div>

    <!-- Price Section -->
    <div class="card mb-4">
      <div class="card-header bg-info text-white">
        Price Per Night
      </div>
      <div class="card-body">
        <table class="table table-hover align-middle">
          <tbody>
            <tr>
              <td class="fw-bold">Default Price</td>
              <td><%= defaultPrice.toLocaleString('en-US', { minimumFractionDigits: 2 }) %> THB</td>
              <td>
                <form action="/edit-price" method="POST" class="d-inline">
                  <input type="hidden" name="edit_id" value="<%= priceId %>">
                  <button type="submit" class="btn btn-sm btn-warning">Edit</button>
                </form>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <hr>
    <!-- Bookings Section -->
    <div class="card">
      <div class="card-header bg-success text-white">
        Bookings
      </div>
      <div class="card-body">
        <table class="table table-striped table-bordered align-middle">
          <thead>
            <tr>
              <th>Name</th>
              <th>Check-in</th>
              <th>Check-out</th>
              <th>Nights</th>
              <th>Total Price</th>
              <th>Paid Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% bookings.forEach(function(item){ %>
              <tr>
                <td><%= item.name %></td>
                <td><%= new Date(item.checkInDate).toLocaleDateString() %></td>
                <td><%= new Date(item.checkOutDate).toLocaleDateString() %></td>
                <td><%= item.nights %></td>
                <td><%= item.total %> </td>
                <td class="<%= item.isPaid ? 'paid' : 'unpaid' %>">
                  <%= item.isPaid ? 'Paid' : 'Not Paid' %>
                </td>
                <td>
                  <form action="/edit-booking" method="POST" class="d-inline">
                    <input type="hidden" name="edit_id" value="<%= item._id %>">
                    <button type="submit" class="btn btn-sm btn-primary">Edit</button>
                  </form>
                  <a class="btn btn-sm btn-danger" 
                     href="/delete-booking/<%= item._id %>" 
                     onclick="return confirm('Do you want to delete?')">Delete</a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
        <div class="container mt-4">
          <!-- <h2>Admin Dashboard</h2> -->

          <!-- Other dashboard content here -->

          <!-- Button to go to booking form -->
          <a href="/book-form" class="btn btn-primary">
            ➕ Create New Booking
          </a>
        </div>
      </div>
    </div>

    <!-- Guest Message Section -->
    <div class="card mb-4" style="margin-top: 5vh;">
      <div class="card-header bg-info text-white">
        Guests Messages
      </div>
      <div class="card-body">
        <table class="table table-striped table-bordered align-middle">
          <thead>
            <tr>
              <th>Name</th>
              <th>Phone</th>
              <th>Email</th>
              <th>Message</th>
            </tr>
          </thead>
          <tbody>
            <% contactus.forEach(function(item){ %>
              <tr>
                <td><%= item.name %></td>
                <td><%= item.phone %></td>
                <td><%= item.email %></td>
                <td><%= item.message %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  

  <script>
    const revenue = JSON.parse('<%- JSON.stringify(revenue || []) %>');

    const labels = revenue.map(r => {
      const monthNames = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
      return monthNames[r.month - 1] + " " + r.year;
    });

    const data = revenue.map(r => r.totalRevenue);

    const ctx = document.getElementById("revenueChart").getContext("2d");
    new Chart(ctx, {
      type: "bar",
      data: {
        labels: labels,
        datasets: [{
          label: "Revenue (฿)",
          data: data,
          backgroundColor: "rgba(13, 110, 253, 0.7)",
          borderRadius: 5
        }]
      },
      options: {
        responsive: true,
        plugins: {
          legend: { display: true }
        },
        scales: {
          y: {
            beginAtZero: true,
            title: { display: true, text: "Total Revenue (฿)" }
          },
          x: {
            title: { display: true, text: "Month" }
          }
        }
      }
    });
  </script>
</body>
</html>
