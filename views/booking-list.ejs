  <style>
    /* ==== Responsive Table Styling ==== */
    .table-responsive-custom {
      width: 100%;
      overflow-x: auto;
      border-radius: 10px;
      border: 1px solid #ddd;
    }

    .responsive-table {
      width: 100%;
      border-collapse: collapse;
      background: #302f2f;
    }

    .responsive-table th {
      background: #242323;
      font-weight: bold;
      padding: 12px;
      text-align: left;
      border-bottom: 2px solid #ddd;
    }

    .responsive-table td {
      padding: 12px;
      border-bottom: 1px solid #eee;
    }

    /* Hover effect */
    .responsive-table tbody tr:hover {
      background: #6d6565;
    }

    /* Mobile responsive: turn table into cards */
    @media (max-width: 768px) {
      .responsive-table,
      .responsive-table thead,
      .responsive-table tbody,
      .responsive-table th,
      .responsive-table td,
      .responsive-table tr {
        display: block;
      }

      .responsive-table thead {
        display: none;
      }

      .responsive-table tr {
        margin-bottom: 12px;
        border: 1px solid #eee;
        border-radius: 10px;
        padding: 10px;
      }

      .responsive-table td {
        text-align: left;
        padding-left: 50%;
        position: relative;
        border: none;
        border-bottom: 1px solid #f1f1f1;
      }

      .responsive-table td:last-child {
        border-bottom: none;
      }

      .responsive-table td:before {
        content: attr(data-label);
        position: absolute;
        left: 12px;
        top: 12px;
        font-weight: bold;
        text-transform: capitalize;
      }
    }

    .pagination {
      margin-top: 15px;
      display: flex;
      gap: 10px;
      align-items: center;
    }

    .pagination a {
      padding: 5px 12px;
      border: 1px solid #ccc;
      border-radius: 6px;
      text-decoration: none;
    }

    .pagination a:hover {
      background: #f2f2f2;
    }


    /* Buttons */
      .btn-sm {
        padding: 5px 10px;
        font-size: 12px;
        border-radius: 5px;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
      }

      .btn-edit {
        background: #007bff;
        color: white;
      }

      .btn-edit:hover {
        background: #0056b3;
      }

      .btn-delete {
        background: #dc3545;
        color: white;
        border: none;
      }

      .btn-delete:hover {
        background: #b52a37;
      }

      /* Make action buttons stack nicely on mobile */
      @media (max-width: 768px) {
        .action-buttons {
          display: flex;
          gap: 5px;
          flex-wrap: wrap;
        }
        .btn-sm {
          width: 100%;
          text-align: center;
        }
      }

      .filter-bar {
        display: flex;
        gap: 12px;
        align-items: center;
        margin-bottom: 15px;
        padding: 10px;
        background: #181a1c;
        border-radius: 8px;
        color: #302f2f;
      }

      .filter-item {
        display: flex;
        flex-direction: column;
      }

      .filter-item label {
        font-size: 12px;
        margin-bottom: 3px;
        color: #f0ebeb;
      }

      .filter-item select {
        padding: 6px;
        border-radius: 5px;
        border: 1px solid #ccc;
      }

      /* Mobile responsive */
      @media (max-width: 600px) {
        .filter-bar {
          flex-direction: column;
          align-items: flex-start;
        }
      }

      .export-btn {
        padding: 10px 18px;
        background-color: #198754;
        color: white;
        font-size: 14px;
        border-radius: 8px;
        font-weight: 600;
        text-decoration: none;
        display: inline-block;
        box-shadow: 0 2px 6px rgba(0,0,0,0.15);
        transition: 0.2s ease;
      }

      .export-btn:hover {
        background-color: #1e40af; /* blue-700 */
      }



  </style>

