<!DOCTYPE html>
<html>
<head>
  <!-- <meta name="viewport" content="width=device-width, initial-scale=1.0"> -->
  <!-- <title>Select Table</title> -->
  <link rel="stylesheet" href="/css/floor.css">
  

  <!-- Basic -->
  <meta charset="utf-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <!-- Mobile Metas -->
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
  <!-- Site Metas -->
  <meta name="keywords" content="" />
  <meta name="description" content="" />
  <meta name="author" content="" />
  <link rel="shortcut icon" href="images/favicon.png" type="">

  <title>The Stereo Bar </title>

  <!-- bootstrap core css -->
  <link rel="stylesheet" type="text/css" href="/css/bootstrap.css" />

  <!--owl slider stylesheet -->
  <link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.carousel.min.css" />
  <!-- nice select  -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jquery-nice-select/1.1.0/css/nice-select.min.css" integrity="sha512-CruCP+TD3yXzlvvijET8wV5WxxEh5H8P4cmz0RFbKK6FlZ2sYl3AEsKlLPHbniXKSrDdFewhbmBK5skbdsASbQ==" crossorigin="anonymous" />
  <!-- font awesome style -->
  <link href="/css/font-awesome.min.css" rel="stylesheet" />

  <!-- Custom styles for this template -->
  <link href="/css/style.css" rel="stylesheet" />
  <!-- responsive style -->
  <link href="/css/responsive.css" rel="stylesheet" />
  
</head>
<body>
  <div class="hero_area">
    <div class="bg-box">
      <img src="/images/hero-bg.jpg" alt="">
    </div>

    <!-- header section strats -->
    <header class="header_section">
      <div class="container">
        <nav class="navbar navbar-expand-lg custom_nav-container ">
          <a class="navbar-brand" href="/">
            <span>
              The Stereo Bar
            </span>
          </a>

          <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
            <span class=""> </span>
          </button>

          <div class="collapse navbar-collapse" id="navbarSupportedContent">
            <ul class="navbar-nav  mx-auto " style="padding-left: 10%;">
              <li class="nav-item">
                <a class="nav-link" href="/stereo-booking-list">รายชื่อลูกค้า</a>
              </li>
              <li class="nav-item ">
                <a class="nav-link" href="/stereo-dashboard">กราฟสถิติ </a>
              </li>
              <li class="nav-item active">
                <a class="nav-link" href="/stereo-book">จองโต๊ะ <span class="sr-only">(current)</span></a>
              </li>
              <% if (isAdmin) { %>
              <li class="nav-item ">
                <a class="nav-link" href="/members">จัดการสมาชิก  </a>
              </li>
              <% } %>
            </ul>
            <div class="user_option" style="color: rgb(230, 152, 8); margin-top: 15px;">
              <p>สวัสดี, <%= username %></p>

              <% if (isLogin) { %>
                <a href="/logout" class="btn btn-primary" style="margin-bottom: 15px;">Logout</a>
              <% } %>
            </div>
          </div>
        </nav>
      </div>
    </header>
    <!-- end header section -->

    <div style="align-content: center; font-size: large; color: azure;">
      <h2>
        แก้ไขข้อมูลการจอง
      </h2>
    </div>

  <div class="floorplan-overlay">
    <div class="date-card">
      <label>Select Date</label>
      <input
        type="date"
        id="datePicker"
        value="<%= booking.bookingDateTime.toISOString().slice(0,10) %>"
      >
    </div>

    <div id="edit-stereobar-floor" class="floor-container"></div>
    <div id="tooltip" class="tooltip"></div>
  </div>

<section class="booking-section">
  <h3 style="color: azure;">โปรดระบุข้อมูลลูกค้า</h3>

  <div class="form">
    <input type="hidden" id="update_id" value="<%= booking._id %>">

    <input type="text" id="name" value="<%= booking.name %>" required>

    <input
      type="tel"
      id="phone"
      value="<%= booking.phone %>"
      pattern="^(0[0-9]{9})"
      required
    >

    <select id="timePicker" required></select>

    <input type="number" id="amount" value="<%= booking.amount %>" required>

    <!-- Transfer -->
    <select id="transfer" required>
      <option value="0" <%= booking.transfer === 0 ? "selected" : "" %>>Not Transfer</option>
      <option value="1000" <%= booking.transfer === 1000 ? "selected" : "" %>>1,000</option>
      <option value="1500" <%= booking.transfer === 1500 ? "selected" : "" %>>1,500</option>
      <option value="2000" <%= booking.transfer === 2000 ? "selected" : "" %>>2,000</option>
    </select>

    <!-- ✅ Multiple Upload -->
    <input
      type="file"
      id="slip"
      accept="image/png, image/jpeg"
      multiple
    >

    <!-- ✅ Preview Container -->
    <div
      id="previewContainer"
      style="
        display:flex;
        flex-wrap:wrap;
        gap:10px;
        margin-top:10px;
      "
    >

    <%
        const images = Array.isArray(booking.image)
          ? booking.image
          : booking.image
            ? [booking.image]
            : [];
      %>

      <% images.forEach(img => { %>

        <img
          src="<%= img %>"
          class="preview-thumb clickable-image"
          style="
            width:120px;
            height:120px;
            object-fit:cover;
            border-radius:8px;
            border:1px solid #555;
            cursor:pointer;
          "
          alt="Slip Image"
        >

      <% }) %>

    </div>

    <div id="imageModal" class="image-modal">
      <span class="close-modal">&times;</span>
      <img class="modal-content" id="modalImage">
    </div>

    <textarea id="remark" placeholder="รายละเอียดเพิ่มเติม"><%= booking.remark || "" %></textarea>
  </div>

  <button id="confirm">Update Reservation</button>
</section>

<script>
  const tables = JSON.parse('<%- JSON.stringify(tables) %>');
  const staticElements = JSON.parse('<%- JSON.stringify(staticElements) %>');
  
</script>

<script>
  window.currentBookingId = "<%= booking._id %>";
  window.existingTables = JSON.parse('<%- JSON.stringify(existingTables || []) %>');
</script>



<script>
  window.existingTime = "<%= booking.bookingDateTime.toTimeString().slice(0,5) %>";
  // window.existingTables = JSON.parse('<%- JSON.stringify(booking.tables) %>');
</script>



<div id="successModal" class="success-modal">
  <div class="success-box">
    <div class="success-icon">✓</div>
    <h2>Reservation Confirmed</h2>
    <p>แก้ไขการจองสำเร็จ</p>
  </div>
</div>

<div id="errorModal" class="error-modal">
  <div class="error-box">
    <div class="error-icon">✕</div>
    <h2>Reservation Failed</h2>
    <p id="errorMessage">มีข้อผิดพลาดเกิดขึ้น</p>
    <button class="error-btn" onclick="closeErrorModal()">กรุณาลองใหม่อีกครั้ง</button>
  </div>
</div>


<script src="/js/edit-stereobar-floor.js"></script>


</body>
</html>
