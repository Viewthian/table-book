  <div class="p-6 bg-gray-100 min-h-screen">

    <!-- === DASHBOARD CARDS ROW === -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

      <!-- Today Check-in -->
      <div class="bg-white rounded-2xl shadow-md p-6 flex items-center gap-4">
        <div class="w-14 h-14 flex items-center justify-center bg-green-100 text-green-600 rounded-full">
          <i class="fas fa-door-open text-2xl"></i>
        </div>
        <div>
          <p class="text-gray-500 text-sm">Today Check-in</p>
          <p class="text-3xl font-bold"><%= todayCheckin %> / <%= todayTotalBookings %></p>
          <p class="text-xs text-green-600 mt-1">Updated Today</p>
        </div>
      </div>

      <!-- Bookings This Month -->
      <div class="bg-white rounded-2xl shadow-md p-6 flex items-center gap-4">
        <div class="w-14 h-14 flex items-center justify-center bg-blue-100 text-blue-600 rounded-full">
          <i class="fas fa-calendar text-2xl"></i>
        </div>
        <div>
          <p class="text-gray-500 text-sm">Bookings This Month</p>
          <p class="text-3xl font-bold"><%= monthlyBookings %></p>
          <p class="text-xs text-blue-600 mt-1">Current month</p>
        </div>
      </div>

      <!-- Total Bookings 2025 -->
      <div class="bg-white rounded-2xl shadow-md p-6 flex items-center gap-4">
        <div class="w-14 h-14 flex items-center justify-center bg-indigo-100 text-indigo-600 rounded-full">
          <i class="fas fa-hotel text-2xl"></i>
        </div>
        <div>
          <p class="text-gray-500 text-sm">Total Bookings (2025)</p>
          <p class="text-3xl font-bold"><%= totalBookings2025 %></p>
          <p class="text-xs text-indigo-600 mt-1">Year 2025</p>
        </div>
      </div>

    </div>

    <!-- === BAR CHART SECTION === -->
    <div class="bg-white p-6 rounded-2xl shadow-md mt-10">
      <h2 class="text-xl font-semibold mb-4 text-gray-700">Monthly Booking Summary</h2>
      <canvas id="bookingBarChart" height="120"></canvas>
    </div>

  </div>



  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <script>
      const labels = JSON.parse('<%- JSON.stringify(monthLabels) %>');
      const bookedData = JSON.parse('<%- JSON.stringify(bookedCounts) %>');
      const checkinData = JSON.parse('<%- JSON.stringify(checkinCounts) %>');
  </script>

  <script>
    const monthNames = [
      "Jan","Feb","Mar","Apr","May","Jun",
      "Jul","Aug","Sep","Oct","Nov","Dec"
    ];

  const ctx = document.getElementById("bookingBarChart").getContext("2d");

  new Chart(ctx, {
    type: "bar",
    data: {
      labels: labels,
      datasets: [
        {
          label: "Booked",
          data: bookedData,
          backgroundColor: "rgba(59, 130, 246, 0.8)"  // Blue
        },
        {
          label: "Check-in",
          data: checkinData,
          backgroundColor: "rgba(16, 185, 129, 0.8)"  // Green
        }
      ]
    },
    options: {
      responsive: true,
      plugins: { legend: { position: "top" } },
      scales: {
        x: { stacked: true },
        y: { stacked: true, beginAtZero: true }
      }
    }
  });
</script>

  


