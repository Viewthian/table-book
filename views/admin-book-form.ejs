<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Create Booking</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
  <style>
    body {
      background-color: #f8f9fa;
      font-family: 'Arial', sans-serif;
    }

    .container {
      max-width: 600px;
      margin: 50px auto;
    }

    .card {
      background: #fff;
      border-radius: 12px;
      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.1);
      padding: 30px;
    }

    h2 {
      text-align: center;
      font-weight: bold;
      margin-bottom: 25px;
      color: #333;
    }

    label {
      font-weight: 600;
      margin-top: 10px;
    }

    .btn-success {
      width: 100%;
      margin-top: 20px;
      padding: 12px;
      font-size: 16px;
      border-radius: 8px;
      transition: background 0.3s;
    }

    .btn-success:hover {
      background-color: #218838;
    }

    .flatpickr-input {
      background-color: #fff !important;
      border: 1px solid #ced4da;
      padding: 10px;
      border-radius: 6px;
      width: 100%;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="card">
      <h2>Create a New Booking</h2>
      <form action="/admin-book" method="POST">
        <div class="mb-3">
          <label for="name">Guest Name</label>
          <input type="text" id="name" name="name" required class="form-control">
        </div>

        <div class="mb-3">
          <label for="email">Email</label>
          <input type="email" id="email" class="form-control" name="email" >
        </div>

        <div class="mb-3">
          <label for="adults">Adults</label>
          <input type="text" id="adults" name="adults"  class="form-control">
        </div>

        <div class="mb-3">
          <label for="checkin">Check-in Date</label>
          <input type="text" id="checkin" name="checkin"  class="form-control flatpickr-input">
        </div>

        <div class="mb-3">
          <label for="checkout">Check-out Date</label>
          <input type="text" id="checkout" name="checkout"  class="form-control flatpickr-input">
        </div>

        <div class="mb-3">
          <label for="nights">Nights</label>
          <input type="text" id="nights" name="nights"  class="form-control">
        </div>

        <button type="submit" class="btn btn-success">Save Booking</button>
      </form>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
  <script>
    flatpickr("#checkin", { dateFormat: "Y-m-d" });
    flatpickr("#checkout", { dateFormat: "Y-m-d" });
  </script>
</body>
</html>
