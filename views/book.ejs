  <!-- book section -->
<section class="book_section layout_padding">
  <div class="container">
    <div class="heading_container">
      <h2>Book A Table</h2>
    </div>

    <div class="row">
      <div class="col-md-6">
        <div class="form_container">
          <form id="reservationForm" action="/reserve" method="POST">
            <% if (messages.error && messages.error.length > 0) { %>
              <div class="alert alert-danger">
                <%= messages.error[0] %>
              </div>
            <% } %>

            <% if (messages.success && messages.success.length > 0) { %>
              <div class="alert alert-success">
                <%= messages.success[0] %>
              </div>
            <% } %>
            <div>
              <small class="text-danger" id="nameError"></small>
              <input type="text" id="name" class="form-control" name="name" value="" placeholder="Customer name">
              
            </div>

            <div>
              <small class="text-danger" id="phoneError"></small>
              <input type="tel" id="phone" class="form-control" name="phone" pattern="^(0[0-9]{9}|\+66[0-9]{9})$"  value="" placeholder="Ex: 0812345678 or +66812345678">
              
            </div>

            <div>
              <input type="email" id="email" name="email" class="form-control" placeholder="Email" />
            </div>

            <!-- Zone selection -->
            <div>
              <small class="text-danger" id="zoneError"></small>
              <select id="zone" name="zone" class="form-control" value="">
                <option value="" disabled selected>Select Zone</option>
                <option value="1">Zone 1</option>
                <option value="2">Zone 2</option>
                <option value="3">Zone 3</option>
                <option value="4">Zone 4</option>
                <option value="5">Zone 5</option>
                <option value="6">Zone 6</option>
                <option value="TK">Karaoke</option>
              </select>
            </div>

            <!-- Table number selection -->
            <div>
              <small class="text-danger" id="tableNoError"></small>
              <select id="tableNo" name="tableNo" class="form-control" value="">
                <option value="" disabled selected>Select Table Number</option>
              </select>
              
            </div>

            <div>
              <small class="text-danger" id="amountError"></small>
              <input type="number" id="amount" name="guests" class="form-control" placeholder="How many persons?" value=""/>
              
            </div>

            <div>
              <input type="date" id="resDate" name="resDate" class="form-control">
              <select id="resTime" name="resTime" class="form-control">
                <option value="" disabled selected>Select Time</option>
              </select>
              <small class="text-danger" id="resTimeError"></small>
            </div>

            <div>
              <input type="text" id="note" name="note" class="form-control" placeholder="Special request" />
            </div>

            <div class="btn_box">
              <button type="submit">Book Now</button>
            </div>
          </form>
        </div>
      </div>

    </div>
  </div>
</section>
<!-- end book section -->

