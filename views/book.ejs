  <script>
    document.getElementById("phone").addEventListener("input", function() {
      const phone = this.value.trim();
      const phoneRegex = /^(0[0-9]{8,9}|\+66[0-9]{8,9})$/;

      if (!phoneRegex.test(phone)) {
        this.setCustomValidity("Enter a valid Thai phone number (Ex: 0812345678 or +66812345678).");
      } else {
        this.setCustomValidity("");
      }
    });
  </script>

  <script>
    document.getElementById('reservationForm').addEventListener('submit', function (e) {
        e.preventDefault(); // Stop default submission

      // Clear previous errors
      document.querySelectorAll('small.text-danger').forEach(el => el.innerText = '');

      let hasError = false;
      const form = e.target;
      const formData = new FormData(form);

      // Get form fields
    const name = document.getElementById('name').value.trim();
    const phone = document.getElementById('phone').value.trim();
    const email = document.getElementById('email').value.trim();
    const zone = document.getElementById('zone').value;
    const tableNo = document.getElementById('tableNo').value;
    const amount = document.getElementById('amount').value;
    const resDate = document.getElementById('resDate').value;
    const resTime = document.getElementById('resTime').value;
    // const dateTime = document.getElementById('reservationDateTime').value;
    // const finalDateTime = `${resDate.value}T${resTime.value}`;

    // const staffid = document.getElementById('staffid').value.trim();

      

      // Frontend validation

      // Name validation
      
      if (!name) {
        document.getElementById('nameError').innerText = 'Please enter name';
        hasError = true;
      }
      if (!phone) {
        document.getElementById('phoneError').innerText = 'Please enter phone number';
        hasError = true;
      }
      if (!zone) {
        document.getElementById('zoneError').innerText = 'Please select a zone.';
        hasError = true;
      }
      if (!tableNo) {
        document.getElementById('tableNoError').innerText = 'Please select a table number.';
        hasError = true;
      }
      if (!amount) {
        document.getElementById('amountError').innerText = 'Please enter guests amount.';
        hasError = true;
      }

      if (!resDate) {
          document.getElementById('resDate').innerText =
              'Please select reservation date.';
          hasError = true;
      }

      if (!resTime) {
          document.getElementById('resTime').innerText =
              'Please select reservation time.';
          hasError = true;
      }


      if (!hasError) {
        // e.preventDefault();  // Stop submission ONLY when errors exist
        form.submit()
      }

    });
  </script>
  
  

  


  
  <script>
    document.addEventListener("DOMContentLoaded", function () {

      // TABLE DATA
      const tableData = {
        1: { start: 101, count: 17, prefix: "T"},
        2: { start: 201, count: 20, prefix: "T"},
        3: { start: 301, count: 20, prefix: "T"},
        4: { start: 401, count: 17, prefix: "T"},
        5: { start: 501, count: 16, prefix: "T"},
        6: { start: 601, count: 6, prefix: "T"},
        7: { start: 701, count: 17, prefix: "T"},
        TK: { start: 1, count: 12, prefix: "K"}
      };

      // TIME SLOT DATA (10:00–22:00, every 30 minutes)
      function generateTimeSlots(start, end) {
        let times = [];
        let hour = start;
        let minute = 0;

        while (hour < end || (hour === end && minute === 0)) {
          let h = hour.toString().padStart(2, "0");
          let m = minute.toString().padStart(2, "0");
          times.push(`${h}:${m}`);

          minute += 30;
          if (minute === 60) {
            minute = 0;
            hour++;
          }
        }
        return times;
      }

      const timeSlots = generateTimeSlots(10, 22); // 10:00–22:00

      // Populate Time Dropdown
      const timeSelect = $("#resTime");
      timeSlots.forEach(t => {
        timeSelect.append(`<option value="${t}">${t}</option>`);
      });
      timeSelect.niceSelect("update");

      // ZONE → TABLE LOGIC
      $("#zone").on("change", function () {
        const zone = $(this).val();
        const tableSelect = $("#tableNo");

        tableSelect.empty();
        tableSelect.append('<option disabled selected>Select Table Number</option>');

        if (tableData[zone]) {

            const { start, count, prefix } = tableData[zone];

            for (let i = 0; i < count; i++) {
              const number = start + i;

              // Display and value
              const display = `${prefix}${number}`;

              tableSelect.append(`<option value="${display}">${display}</option>`);
            }
          }

        tableSelect.niceSelect("update");
      });

    });
  </script>


</body>

