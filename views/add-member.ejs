  <script>
    document.addEventListener("DOMContentLoaded", function () {

      // TABLE DATA
      const tableData = {
        1: { start: 101, count: 17, prefix: "T"},
        2: { start: 201, count: 20, prefix: "T"},
        3: { start: 301, count: 20, prefix: "T"},
        4: { start: 401, count: 17, prefix: "T"},
        5: { start: 501, count: 16, prefix: "T"},
        6: { start: 601, count: 6, prefix: "T"},
        7: { start: 701, count: 17, prefix: "T"},
        TK: { start: 1, count: 12, prefix: "K"}
      };

      // TIME SLOT DATA (10:00–22:00, every 30 minutes)
      function generateTimeSlots(start, end) {
        let times = [];
        let hour = start;
        let minute = 0;

        while (hour < end || (hour === end && minute === 0)) {
          let h = hour.toString().padStart(2, "0");
          let m = minute.toString().padStart(2, "0");
          times.push(`${h}:${m}`);

          minute += 30;
          if (minute === 60) {
            minute = 0;
            hour++;
          }
        }
        return times;
      }

      const timeSlots = generateTimeSlots(10, 22); // 10:00–22:00

      // Populate Time Dropdown
      const timeSelect = $("#resTime");
      timeSlots.forEach(t => {
        timeSelect.append(`<option value="${t}">${t}</option>`);
      });
      timeSelect.niceSelect("update");

      // ZONE → TABLE LOGIC
      $("#zone").on("change", function () {
        const zone = $(this).val();
        const tableSelect = $("#tableNo");

        tableSelect.empty();
        tableSelect.append('<option disabled selected>Select Table Number</option>');

        if (tableData[zone]) {

            const { start, count, prefix } = tableData[zone];

            for (let i = 0; i < count; i++) {
              const number = start + i;

              // Display and value
              const display = `${prefix}${number}`;

              tableSelect.append(`<option value="${display}">${display}</option>`);
            }
          }

        tableSelect.niceSelect("update");
      });

    });
  </script>


